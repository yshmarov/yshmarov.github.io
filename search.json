---
layout: null
---
{%- comment -%}
  site.llm_posts, not site.posts: llms.txt advertises this file as an LLM
  endpoint, and drafts must stay out of it even in a --drafts build.
{%- endcomment -%}
[
  {%- for post in site.llm_posts -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "markdown_url": {{ post.md_url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "bytes": {{ post.md_bytes }},
    "excerpt": {{ post.description | default: post.excerpt | strip_html | truncate: 160 | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
